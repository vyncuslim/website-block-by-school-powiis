{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-block-by-school-powiis",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  // Observe only by default. No live website routes are configured.
  "vars": {
    "MODE": "observe"
  },
  // Pin the existing Cloudflare production KV namespace to prevent redeploy drift.
  "kv_namespaces": [
    {
      "binding": "SCHOOL_IP_KV",
      "id": "afbc03d02494467e8f39b63f755de44d"
    }
  ]
}
